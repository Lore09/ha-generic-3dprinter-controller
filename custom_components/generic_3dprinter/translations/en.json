{
  "config": {
    "step": {
      "user": {
        "title": "Add a 3D printer",
        "description": "This integration speaks {count} printer protocols. You can let it look for a printer on your network, or choose the protocol yourself.",
        "data": {
          "discover": "Look for a printer on my network"
        }
      },
      "pick": {
        "title": "Which printer?",
        "description": "More than one printer answered. Pick the one to set up; the others can be added the same way afterwards.",
        "data": {
          "printer": "Printer"
        }
      },
      "protocol": {
        "title": "Which protocol does the printer speak?",
        "description": "Pick the printer's control protocol, or its product line where one is listed. If you are unsure, choose Web page only and the integration will proxy the printer's own page.",
        "data": {
          "protocol": "Protocol"
        }
      },
      "model": {
        "title": "Which model is it?",
        "description": "The {family} models speak different protocols. Pick the one you own.",
        "data": {
          "protocol": "Model"
        }
      },
      "details": {
        "title": "Printer details",
        "description": "{protocol}. Default port: {ports}.\n\n{evidence}\n\n{detail}",
        "data": {
          "name": "Name",
          "host": "Host or IP address",
          "port": "Port",
          "web_url": "Web UI address",
          "camera_port": "Camera port",
          "serial": "Serial number (found automatically when left empty)",
          "tls": "Use TLS",
          "verify_ssl": "Verify the TLS certificate",
          "scan_interval": "Poll interval",
          "api_key": "API key",
          "username": "Username",
          "password": "Password",
          "access_code": "Access code"
        }
      },
      "unsafe": {
        "title": "Commands that can damage the printer",
        "description": "{hazards}\n\nLeave these off unless you accept the risk. You can change them later in the integration options.",
        "data": {
          "unsafe_sdcp_start_print": "Allow starting a print over the network",
          "unsafe_cc2_start_print": "Allow starting a print over the network",
          "unsafe_kobra_start_print": "Allow starting a print over the network",
          "unsafe_sdcp_resin_start_print": "Allow starting a resin print over the network",
          "unsafe_sdcp_resin_camera": "Allow the resin printer's camera"
        }
      }
    },
    "error": {
      "invalid_config": "That configuration is not usable. Check the address, the port and any credential.",
      "discovery_failed": "Nothing answered. Enter the printer's address by hand and choose its protocol.",
      "cannot_connect": "The printer did not answer.",
      "invalid_auth": "The printer refused the credential."
    },
    "abort": {
      "already_configured": "That printer is already configured.",
