  "services": {
    "send_command": {
      "name": "Send a command",
      "description": "Send one normalised command to a printer, going through the same checks as a dashboard button.",
      "fields": {
        "entry_id": {
          "name": "Printer",
          "description": "The printer to command."
        },
        "command": {
          "name": "Command",
          "description": "Which command to send."
        },
        "data": {
          "name": "Parameters",
          "description": "Parameters for the command."
        }
      }
    },
    "upload_file": {
      "name": "Upload a file",
      "description": "Upload a G-code file to a printer's storage.",
      "fields": {
        "entry_id": {
          "name": "Printer",
          "description": "The printer to upload to."
        },
        "filename": {
          "name": "File name",
          "description": "Name to store the file under."
        },
        "data": {
          "name": "Contents",
          "description": "The file contents, base64 encoded."
        }
      }
    }
  },
  "exceptions": {
    "wrong_printer": {
      "message": "{host} answers as {model}, a resin printer, and this entry drives a Centauri Carbon. Remove it and add the printer as an Elegoo resin printer."
    },
    "not_a_resin_printer": {
      "message": "{host} answers as {model}, which is not a resin printer, and this entry drives an Elegoo resin printer. Remove it and add the printer under its own protocol."
    },
    "other_resin_printer": {
      "message": "{host} answers as {model} with another mainboard id than the one this entry was set up for. Remove the entry and add this printer again."
    }
  }
